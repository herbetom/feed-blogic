'use strict';

import * as unetmsg from 'unetmsg.client';
import * as libubus from 'ubus';
import * as uloop from 'uloop';
import * as libuci from 'uci';

const DEFAULT_TIMEOUT = 3600;
const DEFAULT_BANDS = [ '2g', '5g' ];

let chan;
let active = {};
let profiles = {};

uloop.init();
let ubus = libubus.connect();

function procd_data() {
	const wireless_status = ubus.call('network.wireless', 'status');
	if (!wireless_status)
		return libubus.STATUS_NOT_SUPPORTED;

	let data = {};
	for (let radio, v in wireless_status) {
		if (!v.up)
			continue;
		for (let network, config in active) {
			for (let band in config.bands) {
				if (!(band == v.config.band || band in v.config.band))
					continue;
				data[radio] ??= {};
				data[radio][config.config.ssid] = {
					device: radio,
					config: config.config,
				}
			}
		}
	}
	ubus.call('service', 'set', {
		name: 'wifi-dynamic',
		data: { 'wifi-iface': data }
	});

	ubus.call('network', 'reload');

	return libubus.STATUS_OK;
}

let procd_timer;
function procd_data_schedule() {
	if (procd_timer)
		return procd_timer.set(200);

	procd_timer = uloop.timer(200, () => {
		procd_timer = null;
		procd_data();
	});
}

function networks_owned() {
	let owned = {};

	for (let name, entry in active) {
		if (entry.origin)
			continue;

		owned[name] = {
			bands: entry.bands,
			ssid: entry.config.ssid,
			encryption: entry.config.encryption,
			key: entry.config.key,
		};
	}

	return owned;
}

function networks_send() {
	if (chan)
		chan.send('wifi-dyn', 'networks', { networks: networks_owned() });
}

function networks_recv(host, networks) {
	if (!host)
		return;

	for (let name in keys(active))
		if (active[name].origin == host)
			delete active[name];

	for (let name, config in networks ?? {}) {
		if (active[name])
			continue;

		active[name] = {
			origin: host,
			bands: config.bands,
			config: {
				mode: 'ap',
				ssid: config.ssid,
				network: [ name ],
				encryption: config.encryption,
				key: config.key,
			},
		};
	}

	procd_data_schedule();
}

function networks_request() {
	if (!chan)
		return;

	chan.request('wifi-dyn', 'networks', {}, (msg) => {
		networks_recv(msg.host, msg.networks);
	}, () => {});
}

function timer_expired_cb() {
	let expired = [];

	for (let name, network in active) {
		if (!network.timer)
			continue;
		if (network.timer.remaining() > 0)
			continue;
		push(expired, name);
	}

	if (!length(expired))
		return;

	for (let name in expired)
		delete active[name];

	procd_data();
	networks_send();
}

/* A single 'list bands' entry can arrive as a bare string. */
function bands_normalise(bands) {
	if (!bands)
		return DEFAULT_BANDS;

	return type(bands) == 'array' ? bands : [ bands ];
}

function profiles_load() {
	let cursor = libuci.cursor();

	profiles = {};

	if (!cursor.load('wireless'))
		return warn("wifi-dynamic: cannot load /etc/config/wireless\n");

	cursor.foreach('wireless', 'wifi-dynamic', (s) => {
		const name = s['.name'];

		if (!s.ssid || !s.key || !s.network)
			return warn(`wifi-dynamic: ${name} needs ssid, key and network\n`);

		const key_length = length(s.key);
		if (key_length < 8 || key_length > 63)
			return warn(`wifi-dynamic: ${name} key is ${key_length} characters\n`);

		const ssid_length = length(s.ssid);
		if (ssid_length < 1 || ssid_length > 32)
			return warn(`wifi-dynamic: ${name} ssid is ${ssid_length} characters\n`);

		profiles[name] = {
			name,
			ssid: s.ssid,
			key: s.key,
			network: s.network,
			encryption: s.encryption ?? 'sae',
			bands: bands_normalise(s.bands),
			timeout: +(s.timeout ?? DEFAULT_TIMEOUT),
		};
	});
}

function network_start(cfg, timeout, profile) {
	if (active[cfg.network] && !active[cfg.network].origin)
		return libubus.STATUS_PERMISSION_DENIED;

	for (let k in [ 'network', 'ssid', 'key', 'encryption', 'bands' ])
		if (!cfg[k])
			return libubus.STATUS_INVALID_ARGUMENT;

	const key_length = length(cfg.key);
	if (key_length < 8 || key_length > 63)
		return libubus.STATUS_INVALID_ARGUMENT;

	const ssid_length = length(cfg.ssid);
	if (ssid_length < 1 || ssid_length > 32)
		return libubus.STATUS_INVALID_ARGUMENT;

	if (!ubus.call('network.interface.' + cfg.network, 'status'))
		return libubus.STATUS_INVALID_ARGUMENT;

	active[cfg.network] = {
		bands: cfg.bands,
		profile,
		config: {
			mode: 'ap',
			ssid: cfg.ssid,
			network: [ cfg.network ],
			encryption: cfg.encryption,
			key: cfg.key,
		},
	};

	if (timeout)
		active[cfg.network].timer = uloop.timer(timeout * 1000, timer_expired_cb);

	let status = procd_data();
	networks_send();

	return status;
}

function network_stop(network) {
	if (!active[network])
		return libubus.STATUS_NOT_FOUND;
	if (active[network].origin)
		return libubus.STATUS_NOT_SUPPORTED;

	delete active[network];

	let status = procd_data();
	networks_send();

	return status;
}

function network_extend(network, timeout) {
	if (!active[network])
		return libubus.STATUS_NOT_FOUND;
	if (active[network].origin)
		return libubus.STATUS_NOT_SUPPORTED;
	if (!timeout || !active[network].timer)
		return libubus.STATUS_INVALID_ARGUMENT;

	const left = active[network].timer.remaining();

	active[network].timer.set((left > 0 ? left : 0) + timeout * 1000);

	return libubus.STATUS_OK;
}

function profile_state(p) {
	let entry = active[p.network];
	let running = entry && !entry.origin && entry.profile == p.name;

	return {
		name: p.name,
		ssid: p.ssid,
		key: p.key,
		encryption: p.encryption,
		bands: join('/', p.bands),
		network: p.network,
		timeout: p.timeout,
		active: !!running,
		remaining: running && entry.timer ? entry.timer.remaining() / 1000 : 0,
	};
}

profiles_load();

chan = unetmsg.open(ubus);

chan.subscribe('wifi-dyn', (req) => {
		networks_recv(req.args.host, req.args.data.networks);
	}, () => {
		for (let name in keys(active))
			if (active[name].origin)
				delete active[name];

		procd_data_schedule();
		networks_request();
		networks_send();
	});

chan.publish('wifi-dyn', (req) => {
	if (req.args.type == 'networks')
		return { networks: networks_owned() };

	return 0;
});

let ubus_methods = {
	add: {
		call: function(req) {
			return network_start({
				network: req.args.network,
				ssid: req.args.ssid,
				key: req.args.key,
				encryption: req.args.encryption,
				bands: req.args.bands,
			}, req.args.timeout, null);
		},
		args: {
			bands: [ '2g', '5g' ],
			network: 'lan',
			ssid: 'wifi-dynamic',
			key: '00000000',
			encryption: 'sae',
			timeout: 60
		}
	},

	remove: {
		call: function(req) {
			return network_stop(req.args.network);
		},
		args: {
			network: 'guest',
		},
	},

	update: {
		call: function(req) {
			return network_extend(req.args.network, req.args.timeout);
		},
		args: {
			network: 'guest',
			timeout: 60,
		},
	},

	status: {
		call: function(req) {
			let ret = {
				network: req.args.network,
				active: false,
			};

			let network = active[req.args.network];
			if (network) {
				ret.active = true;
				ret.origin = network.origin ?? 'local';
				ret.ssid = network.config.ssid;
				ret.key = network.config.key;
				ret.encryption = network.config.encryption;
				if (network.profile)
					ret.profile = network.profile;
				if (network.timer)
					ret.remaining = network.timer.remaining() / 1000;
			}

			return ret;
		},
		args: {
			network: 'guest',
		},
	},

	dump: {
		call: function(req) {
			return active;
		},
		args: {},
	},

	list: {
		call: function(req) {
			let out = [];

			for (let name, p in profiles)
				push(out, profile_state(p));

			return { profiles: out };
		},
		args: {},
	},

	enable: {
		call: function(req) {
			let p = profiles[req.args.name];
			if (!p)
				return libubus.STATUS_NOT_FOUND;

			return network_start({
				network: p.network,
				ssid: p.ssid,
				key: p.key,
				encryption: p.encryption,
				bands: p.bands,
			}, req.args.timeout ?? p.timeout, p.name);
		},
		args: {
			name: 'guest',
			timeout: 60,
		},
	},

	disable: {
		call: function(req) {
			let p = profiles[req.args.name];
			if (!p)
				return libubus.STATUS_NOT_FOUND;

			return network_stop(p.network);
		},
		args: {
			name: 'guest',
		},
	},

	extend: {
		call: function(req) {
			let p = profiles[req.args.name];
			if (!p)
				return libubus.STATUS_NOT_FOUND;

			return network_extend(p.network, req.args.timeout ?? p.timeout);
		},
		args: {
			name: 'guest',
			timeout: 60,
		},
	},

	reload: {
		call: function(req) {
			profiles_load();

			return libubus.STATUS_OK;
		},
		args: {},
	}
};
ubus.publish('wifi-dyn', ubus_methods);

uloop.run();
